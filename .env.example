# ===========================================================
# Backend .env — copy to .env and adjust values
# ===========================================================

# Postgres connection string (local dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/record_book

# JWT — 32+ chars random string. Generate with: openssl rand -hex 32
JWT_SECRET=replace_me_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=12h

# Cookie name + flags. Set SECURE_COOKIES=true in production (HTTPS only).
COOKIE_NAME=rb_token
SECURE_COOKIES=false

# CORS — the Vite dev server origin
CORS_ORIGIN=http://localhost:5173

# Server
PORT=4000
NODE_ENV=development

# Default admin (used by `npm run seed:admin`)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
